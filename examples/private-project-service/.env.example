# --- Required ---
# Owner's humanId from AgentBook (same human as the connector that will call)
OWNER_HUMAN_ID=0x...

# Optional domain (must match Hors-Authorization domain clients sign)
HORS_DOMAIN=openagents.eth
PORT=3200

# HMAC key for step-up requestState (>=32 bytes)
HORS_STATE_KEY=private-project-dev-key-min-32-bytes!

# --- Required for 0G verified inference (project.resume / evaluateDecision) ---
OG_ROUTER_API_KEY=sk-...

# --- Required for selfie step-up (project.evaluateDecision) ---
WORLD_RP_ID=rp_...
WORLD_SIGNING_KEY=0x...
WORLD_APP_ID=app_...
